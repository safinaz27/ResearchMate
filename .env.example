# Copy this file to .env and fill in real values. Never commit .env.
# Every variable is optional except GROQ_API_KEY (needed only to call the LLM;
# the automated test suite never needs it).

# --- Groq (LLM generation only) ------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Used if GROQ_MODEL is not available on Groq (checked by scripts/check_groq.py)
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# true = one JSON object per log line (machine-readable); false = human-readable text
LOG_JSON=false

# --- Storage (relative paths are resolved against the project root) -------
DATA_DIR=data
# Leave empty to use SQLite at <DATA_DIR>/researchmate.db
DATABASE_URL=

# --- Local models (run on CPU; cached under <DATA_DIR>/hf_cache) ---------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MODEL_DEVICE=cpu

# --- Ingestion ---------------------------------------------------------------
MAX_UPLOAD_MB=25
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60

# --- Retrieval -------------------------------------------------------------
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RERANK_TOP_N=6
